# API key from https://app.arbitr.ai/settings/api-keys
ARBITR_API_KEY=
# Optional. Defaults to https://api.arbitr.ai
# ARBITR_BASE_URL=https://api.arbitr.ai
# Optional UI host for `arbitr link`. Derived from the API host when omitted.
# ARBITR_UI_URL=https://app.arbitr.ai
# Optional. CLI GET retries; default 3. The library defaults to 0.
# ARBITR_MAX_RETRIES=3
