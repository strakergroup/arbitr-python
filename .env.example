# API key from https://arbitr.straker.ai/settings/api-keys
ARBITR_API_KEY=
# Optional. Defaults to https://api-arbitr.straker.ai
# ARBITR_BASE_URL=https://api-arbitr.straker.ai
# Optional UI host for `arbitr link`. Derived from the API host when omitted.
# ARBITR_UI_URL=https://arbitr.straker.ai
# Optional. CLI GET retries; default 3. The library defaults to 0.
# ARBITR_MAX_RETRIES=3
